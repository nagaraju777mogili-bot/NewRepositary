3. Find Users Who Have Not Created Any Records in the Last 60 Days

SELECT Id, Name 
FROM User 
WHERE Id NOT IN (
    SELECT CreatedById 
    FROM Opportunity 
    WHERE CreatedDate >= LAST_N_DAYS:60
)

SELECT Id, Name 
FROM User 
WHERE Id NOT IN (
    SELECT CreatedById FROM Opportunity WHERE CreatedDate >= LAST_N_DAYS:60
)
AND Id NOT IN (
    SELECT CreatedById FROM Contact WHERE CreatedDate >= LAST_N_DAYS:60
)
AND Id NOT IN (
    SELECT CreatedById FROM Case WHERE CreatedDate >= LAST_N_DAYS:60
)

