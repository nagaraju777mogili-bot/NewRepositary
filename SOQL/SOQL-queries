5. Get Top 5 Accounts by Number of Open Opportunities

SELECT AccountId, COUNT(Id) numOpenOpps
FROM Opportunity
WHERE IsClosed = FALSE
GROUP BY AccountId
ORDER BY COUNT(Id) DESC
LIMIT 5


SELECT Id, Name
FROM Account
WHERE Id IN (
    SELECT AccountId
    FROM Opportunity
    WHERE IsClosed = FALSE
    GROUP BY AccountId
    ORDER BY COUNT(Id) DESC
    LIMIT 5
)
